{
  "name": "msec-consulting",
  "version": "0.1.0",
  "private": true,
  "description": "MSEC CONSULTING — Vitrine SEO + portail client (devis/factures), monorepo Turborepo.",
  "packageManager": "npm@11.19.0",
  "workspaces": [
