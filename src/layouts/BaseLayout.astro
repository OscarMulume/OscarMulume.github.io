---
import '../styles/global.css';
import '../styles/themes.css';
import profile from '../data/profile.json';

interface Props {
  title?: string;
  description?: string;
}

const DEFAULT_TITLE = profile.site.title;
const DEFAULT_DESCRIPTION = profile.site.description;

// L'assistant M-SEC (fichier unique hébergé sur le site M-SEC) n'est affiché que si la variable publique
// est activée au build, après le déploiement de la fonction `assistant`.
const ASSISTANT_SCRIPT = 'https://oscarmulume.github.io/msec-technology-consulting/assistant/v2/msec-assistant.js';
const assistantEnabled = import.meta.env.PUBLIC_ASSISTANT_ENABLED === 'true';

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
} = Astro.props;

const credentials = profile.sections.credentials;
const credentialItems = [...credentials.items, ...credentials.others].map((credential) => ({
  '@type': 'EducationalOccupationalCredential',
  name: credential.name,
  dateCreated: credential.dateTime,
  url: credential.url,
  credentialCategory: 'Badge',
  recognizedBy: {
    '@type': 'EducationalOrganization',
    name: credentials.issuer,
    url: 'https://www.netacad.com/',
  },
}));

const socialLinks = (profile.sections.contact.cards as { href?: string; external?: boolean }[])
  .filter((card) => card.external && card.href)
  .map((card) => card.href as string);

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.site.brand.legalName,
  alternateName: profile.site.brand.fullName,
  jobTitle: 'Consultant IT, réseaux et cybersécurité',
  url: profile.site.url,
  image: `${profile.site.url}/portrait.webp`,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Kinshasa',
    addressCountry: 'CD',
  },
  sameAs: [...socialLinks, credentials.profileUrl],
  worksFor: {
    '@type': 'Organization',
    name: profile.site.company.name,
    url: profile.site.company.url,
  },
  hasCredential: credentialItems,
};
---

<!DOCTYPE html>
<html lang={profile.site.lang} data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content={profile.site.themeColor} />
    <meta property="og:title" content={profile.site.ogTitle} />
    <meta property="og:description" content={profile.site.ogDescription} />
    <meta property="og:type" content="website" />
    <meta name="color-scheme" content="light dark" />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />

    <!-- ═══ Anti-FOUC : applique le thème avant le premier paint ═══ -->
    <script is:inline>
      (function () {
        const STORAGE_KEY = 'msec-theme';
        const THEMES = ['light', 'dark', 'high-contrast'];

        function systemTheme() {
          if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
            return 'dark';
          }
          return 'light';
        }

        function getTheme() {
          try {
            const saved = localStorage.getItem(STORAGE_KEY);
            if (saved && THEMES.indexOf(saved) !== -1) return saved;
          } catch (e) { /* storage indisponible */ }
          return systemTheme();
        }

        var t = getTheme();
        document.documentElement.setAttribute('data-theme', t);
        document.documentElement.style.colorScheme = t === 'high-contrast' ? 'dark' : t;
      })();
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body data-current-theme="light">
    <a class="skip-link" href="#main">{profile.site.skipLink}</a>
    <slot />
    {assistantEnabled && <msec-assistant app="portfolio" lang="fr"></msec-assistant>}
    {assistantEnabled && <script is:inline defer src={ASSISTANT_SCRIPT}></script>}
  </body>
</html>
