---
import profile from '../data/profile.json';

const { credentials } = profile.sections;
---

<section id="badges" class="section">
  <div class="section-inner">
    <div class="section-header reveal">
      <div class="section-label">{credentials.label}</div>
      <h2 class="section-title">{credentials.title}</h2>
      <p class="section-desc">{credentials.description}</p>
    </div>
    <div class="badge-grid">
      {credentials.items.map((badge) => (
        <article class="badge-card reveal">
          <img
            class="badge-image"
            src={`/media/badges/${badge.image}`}
            alt={badge.alt}
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-body">
            <p class="badge-issuer">{credentials.issuer}</p>
            <h3>{badge.name}</h3>
            <p class="badge-date">{credentials.issuedLabel} <time datetime={badge.dateTime}>{badge.date}</time></p>
            <ul class="badge-skills">
              {badge.skills.map((skill) => <li>{skill}</li>)}
            </ul>
            <a
              class="badge-link"
              href={badge.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${credentials.verifyLabel} — ${badge.name}`}
            >
              {credentials.verifyLabel} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>
    <div class="badge-others reveal">
      <div>
        <h3>{credentials.othersLabel}</h3>
        <ul>
          {credentials.others.map((badge) => (
            <li>
              <a href={badge.url} target="_blank" rel="noopener noreferrer">{badge.name}</a>
              <time datetime={badge.dateTime}>{badge.date}</time>
            </li>
          ))}
        </ul>
      </div>
      <a class="btn-s" href={credentials.profileUrl} target="_blank" rel="noopener noreferrer">
        {credentials.profileLabel} <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>
