---
import profile from '../data/profile.json';

const { credentials } = profile.sections;

type CredItem = { name: string; date?: string; dateTime?: string; url?: string };
type CredGroup = { title: string; note?: string; profileLabel?: string; profileUrl?: string; items: CredItem[] };
const credCollections = credentials.collections as CredGroup[];
---

<section id="badges" class="section">
  <div class="section-inner">
    <div class="section-header reveal">
      <div class="section-label">{credentials.label}</div>
      <h2 class="section-title">{credentials.title}</h2>
      <p class="section-desc">{credentials.description}</p>
    </div>

    {credentials.stats && (
      <ul class="cred-stats reveal" aria-label="Récapitulatif des preuves vérifiables">
        {credentials.stats.map((stat) => (
          <li class="cred-stat">
            <span class="cred-stat-value">{stat.value}</span>
            <span class="cred-stat-label">{stat.label}</span>
          </li>
        ))}
      </ul>
    )}

    <h3 class="cred-subtitle reveal">{credentials.featuredLabel}</h3>
    <div class="badge-grid">
      {credentials.items.map((badge) => (
        <article class="badge-card reveal">
          <img
            class="badge-image"
            src={`/media/badges/${badge.image}`}
            alt={badge.alt}
            width="300"
            height="300"
            loading="lazy"
            decoding="async"
          />
          <div class="badge-body">
            <p class="badge-issuer">{credentials.issuer}</p>
            <h4>{badge.name}</h4>
            <p class="badge-date">{credentials.issuedLabel} <time datetime={badge.dateTime}>{badge.date}</time></p>
            <ul class="badge-skills">
              {badge.skills.map((skill) => <li>{skill}</li>)}
            </ul>
            <a
              class="badge-link"
              href={badge.url}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${credentials.verifyLabel} — ${badge.name}`}
            >
              {credentials.verifyLabel} <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      ))}
    </div>

    <div class="cred-collections">
      {credCollections.map((group) => (
        <article class="cred-group reveal">
          <div class="cred-group-head">
            <h3>{group.title}</h3>
            {group.note && <p class="cred-group-note">{group.note}</p>}
          </div>
          <ul class="cred-list">
            {group.items.map((item) => (
              <li class="cred-item">
                {item.url ? (
                  <a
                    class="cred-item-link"
                    href={item.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${credentials.verifyShort} — ${item.name}`}
                  >
                    <span class="cred-item-name">{item.name}</span>
                    <span class="cred-item-verify">{credentials.verifyShort} <span aria-hidden="true">↗</span></span>
                  </a>
                ) : (
                  <div class="cred-item-static">
                    <span class="cred-item-name">{item.name}</span>
                    {item.date && <time class="cred-item-date" datetime={item.dateTime}>{item.date}</time>}
                  </div>
                )}
              </li>
            ))}
          </ul>
          {group.profileUrl && (
            <a class="btn-s cred-group-profile" href={group.profileUrl} target="_blank" rel="noopener noreferrer">
              {group.profileLabel} <span aria-hidden="true">↗</span>
            </a>
          )}
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .cred-stats {
    list-style: none;
    margin: 0 0 2.5rem;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  .cred-stat {
    flex: 1 1 140px;
    max-width: 220px;
    text-align: center;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border, rgba(128, 128, 128, 0.25));
    border-radius: 16px;
    background: var(--surface, rgba(128, 128, 128, 0.06));
  }
  .cred-stat-value {
    display: block;
    font-size: 1.9rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--accent, currentColor);
  }
  .cred-stat-label {
    display: block;
    margin-top: 0.35rem;
    font-size: 0.85rem;
    opacity: 0.75;
  }
  .cred-subtitle {
    font-size: 1.05rem;
    font-weight: 600;
    opacity: 0.8;
    margin: 0 0 1rem;
  }
  .cred-collections {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 2.5rem;
  }
  .cred-group {
    border: 1px solid var(--border, rgba(128, 128, 128, 0.25));
    border-radius: 18px;
    padding: 1.25rem 1.25rem 1.5rem;
    background: var(--surface, rgba(128, 128, 128, 0.04));
    display: flex;
    flex-direction: column;
  }
  .cred-group-head h3 {
    margin: 0 0 0.35rem;
    font-size: 1.1rem;
  }
  .cred-group-note {
    margin: 0 0 1rem;
    font-size: 0.85rem;
    opacity: 0.72;
    line-height: 1.5;
  }
  .cred-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    flex: 1;
  }
  .cred-item-link,
  .cred-item-static {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.6rem 0.75rem;
    border-radius: 12px;
    min-height: 44px;
    box-sizing: border-box;
  }
  .cred-item-link {
    text-decoration: none;
    color: inherit;
    border: 1px solid transparent;
    transition: background 0.15s ease, border-color 0.15s ease;
  }
  .cred-item-link:hover,
  .cred-item-link:focus-visible {
    background: var(--surface-hover, rgba(128, 128, 128, 0.1));
    border-color: var(--border, rgba(128, 128, 128, 0.3));
  }
  .cred-item-name {
    font-size: 0.92rem;
    line-height: 1.4;
  }
  .cred-item-verify {
    flex: none;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--accent, currentColor);
    white-space: nowrap;
  }
  .cred-item-date {
    flex: none;
    font-size: 0.8rem;
    opacity: 0.6;
    white-space: nowrap;
  }
  .cred-group-profile {
    margin-top: 1.1rem;
    align-self: flex-start;
  }
  @media (prefers-reduced-motion: reduce) {
    .cred-item-link { transition: none; }
  }
</style>
