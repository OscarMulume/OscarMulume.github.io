---
import profile from '../data/profile.json';

const { projects } = profile.sections;
---

<section id="projets" class="section">
  <div class="section-inner">
    <div class="section-header reveal">
      <div class="section-label">{projects.label}</div>
      <h2 class="section-title">{projects.title}</h2>
      <p class="section-desc">{projects.description}</p>
    </div>
    <div class="bento-grid">
      {projects.items.map((project, index) => {
        const className = `bento-card reveal reveal-delay-${Math.min(index + 1, 5)} proj-card`;
        return project.href ? (
          <a class={className} href={project.href} target="_blank" rel="noopener noreferrer">
            <div class="proj-head">
              <div class="proj-tag">{project.tag}</div>
              {project.status && <span class="proj-status">{project.status}</span>}
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            {project.linkLabel && <span class="proj-link">{project.linkLabel}</span>}
          </a>
        ) : (
          <div class={className}>
            <div class="proj-head">
              <div class="proj-tag">{project.tag}</div>
              {project.status && <span class="proj-status">{project.status}</span>}
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>
