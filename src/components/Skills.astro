---
import profile from '../data/profile.json';

const { skills } = profile.sections;
---

<section id="competences" class="section">
  <div class="section-inner">
    <div class="section-header reveal">
      <div class="section-label">{skills.label}</div>
      <h2 class="section-title">{skills.title}</h2>
    </div>
    <div class="skills-grid">
      {skills.groups.map((group, index) => (
        <div class={`skill-group reveal reveal-delay-${Math.min(index + 1, 5)}`}>
          <h3>{group.title}</h3>
          <div class="skill-tags">
            {group.tags.map((tag) => (
              <span class="skill-tag">{tag}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
    <div class="certs-section reveal">
      <h3>{skills.certificationsTitle}</h3>
      <div class="certs-wrap">
        {skills.certifications.map((certification) => (
          <span class="cert-pill">{certification}</span>
        ))}
      </div>
    </div>
  </div>
</section>
