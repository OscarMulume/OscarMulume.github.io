---
interface Props {
  portrait: {
    alt: string;
    chips: { className: string; text: string; dot: boolean }[];
    hint: string;
  };
}

const { portrait } = Astro.props;
---

<div class="pfx" id="pfx">
  <div class="pfx-tilt" id="pfxTilt">
    <div class="pfx-glow" aria-hidden="true"></div>
    <div class="pfx-ring" aria-hidden="true"></div>
    <div class="pfx-frame">
      <picture>
        <source
          srcset="/portrait-360.webp 360w, /portrait-540.webp 540w, /portrait-720.webp 720w"
          sizes="(max-width: 768px) 78vw, 420px"
          type="image/webp"
        />
        <img
          class="pfx-img"
          id="pfxImg"
          src="/portrait.jpg"
          width="720"
          height="720"
          alt={portrait.alt}
          fetchpriority="high"
        />
      </picture>
      <div class="pfx-sheen" aria-hidden="true"></div>
    </div>
    {portrait.chips.map((chip) => (
      <div class={`pfx-chip ${chip.className}`} aria-hidden="true">
        {chip.dot && <span class="dot"></span>}
        {chip.text}
      </div>
    ))}
  </div>
  <p class="pfx-hint" id="pfxHint" aria-hidden="true">{portrait.hint}</p>
</div>

<style>
  .pfx {
    --size: min(420px, 78vw);
    position: relative;
    width: var(--size);
    margin: 0 auto;
    perspective: 1100px;
  }
  .pfx-tilt {
    position: relative;
    width: var(--size);
    height: var(--size);
    transform-style: preserve-3d;
    transition: transform 0.2s cubic-bezier(0.22, 0.61, 0.36, 1);
    will-change: transform;
  }
  .pfx-frame {
    position: absolute;
    inset: 8%;
    border-radius: 50%;
    overflow: hidden;
    transform: translateZ(44px);
    box-shadow: 0 34px 70px -24px rgba(15, 23, 42, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.14);
    background: var(--bg2, #e5e7eb);
  }
  .pfx-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
  }
  /* Reflet lumineux qui suit le curseur (uniquement au survol, ordinateur). */
  .pfx-sheen {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.3s ease;
    mix-blend-mode: screen;
    background: radial-gradient(
      240px 240px at var(--mx, 50%) var(--my, 30%),
      rgba(255, 255, 255, 0.5),
      rgba(255, 255, 255, 0) 60%
    );
  }
  .pfx.is-hover .pfx-sheen { opacity: 1; }
  .pfx-glow {
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    background: radial-gradient(circle at 30% 30%, rgba(99, 102, 241, 0.55), rgba(34, 211, 238, 0.25) 45%, transparent 70%);
    filter: blur(28px);
    transform: translateZ(-30px);
  }
  .pfx-ring {
    position: absolute;
    inset: 3%;
    border-radius: 50%;
    border: 1px dashed rgba(99, 102, 241, 0.45);
    transform: translateZ(10px);
    animation: pfx-spin 40s linear infinite;
  }
  .pfx-chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 14px;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 600;
    white-space: nowrap;
    color: var(--text, #0f172a);
    background: var(--nav-bg, rgba(255, 255, 255, 0.82));
    border: 1px solid var(--glass-border, rgba(15, 23, 42, 0.08));
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    box-shadow: 0 10px 30px -12px rgba(15, 23, 42, 0.35);
    transform: translateZ(90px);
  }
  .pfx-chip .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; box-shadow: 0 0 0 4px rgba(34, 197, 94, 0.2); }
  .chip-a { top: 4%; left: -6%; }
  .chip-b { top: 46%; right: -8%; }
  .chip-c { bottom: 6%; left: 2%; }
  .pfx-hint {
    margin-top: 14px;
    text-align: center;
    font-size: 12px;
    letter-spacing: 0.04em;
    color: var(--text3, #64748b);
    opacity: 0;
    transition: opacity 0.4s;
  }
  .pfx.is-hover .pfx-hint { opacity: 1; }
  @keyframes pfx-spin { to { transform: translateZ(10px) rotate(360deg); } }
  @media (max-width: 640px) {
    .chip-a { left: -2%; }
    .chip-b { right: -2%; }
    .pfx-chip { font-size: 11px; padding: 6px 10px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pfx-ring { animation: none; }
    .pfx-tilt { transition: none; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById('pfx');
    const tilt = document.getElementById('pfxTilt') as HTMLElement | null;
    if (!root || !tilt) return;

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

    // Effet « Élégant 3D » : la photo (nette) s'incline vers le pointeur,
    // avec un reflet lumineux qui suit le curseur. Aucune pixellisation.
    const frame = root.querySelector('.pfx-frame') as HTMLElement | null;
    const area = (root.closest('.hero') as HTMLElement | null) || root;

    const apply = (clientX: number, clientY: number) => {
      const r = root.getBoundingClientRect();
      const px = (clientX - r.left) / r.width;
      const py = (clientY - r.top) / r.height;
      root.classList.add('is-hover');
      if (!reduce) tilt.style.transform = `rotateY(${(px - 0.5) * 16}deg) rotateX(${-(py - 0.5) * 16}deg)`;
      if (frame) {
        frame.style.setProperty('--mx', Math.max(0, Math.min(100, px * 100)) + '%');
        frame.style.setProperty('--my', Math.max(0, Math.min(100, py * 100)) + '%');
      }
    };
    const reset = () => { root.classList.remove('is-hover'); tilt.style.transform = ''; };

    if (finePointer) {
      area.addEventListener('mousemove', (e) => apply((e as MouseEvent).clientX, (e as MouseEvent).clientY));
      area.addEventListener('mouseleave', reset);
    }
    // Tactile : léger reflet/inclinaison en suivant le doigt sur la photo.
    root.addEventListener('touchmove', (e) => {
      const t = (e as TouchEvent).touches[0];
      if (t) apply(t.clientX, t.clientY);
    }, { passive: true });
    root.addEventListener('touchend', reset);
  })();
</script>
