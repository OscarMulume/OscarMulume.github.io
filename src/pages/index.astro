---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import About from '../components/About.astro';
import Services from '../components/Services.astro';
import Process from '../components/Process.astro';
import Experience from '../components/Experience.astro';
import Projects from '../components/Projects.astro';
import Skills from '../components/Skills.astro';
import Cv from '../components/Cv.astro';
import Contact from '../components/Contact.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <!-- Background FX -->
  <canvas id="bgCanvas" aria-hidden="true"></canvas>
  <div class="bg-orb orb-1"></div>
  <div class="bg-orb orb-2"></div>
  <div class="bg-orb orb-3"></div>

  <Nav />

  <main id="main">
    <Hero />

    <hr class="sep" />

    <About />

    <hr class="sep" />

    <Services />

    <hr class="sep" />

    <Process />

    <hr class="sep" />

    <Experience />

    <hr class="sep" />

    <Projects />

    <hr class="sep" />

    <Skills />

    <hr class="sep" />

    <Cv />

    <hr class="sep" />

    <Contact />
  </main>

  <Footer />

  <div class="cursor-dot" aria-hidden="true"></div>
  <div class="cursor-ring" aria-hidden="true"></div>

  <!-- ═══ Scripts ═══ -->
  <script>
    // Nav scroll
    const nav = document.getElementById('nav')!;
    window.addEventListener('scroll', () => nav.classList.toggle('scrolled', window.scrollY > 50));

    // Mobile menu
    const mobBtn = document.getElementById('mobBtn')!;
    const mobMenu = document.getElementById('mobMenu')!;
    mobBtn.addEventListener('click', () => mobMenu.classList.toggle('open'));
    mobMenu.querySelectorAll('a').forEach(a => a.addEventListener('click', () => mobMenu.classList.remove('open')));

    // Year
    const year = document.getElementById('yr');
    if (year) year.textContent = String(new Date().getFullYear());

    // Scroll Reveal (Intersection Observer)
    const reveals = document.querySelectorAll('.reveal');
    const revealObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          revealObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.1, rootMargin: '0px 0px -40px 0px' });
    reveals.forEach(el => revealObserver.observe(el));

    // Bento card mouse glow
    document.querySelectorAll<HTMLElement>('.bento-card').forEach(card => {
      card.addEventListener('mousemove', (e) => {
        const r = card.getBoundingClientRect();
        card.style.setProperty('--mx', (e.clientX - r.left) + 'px');
        card.style.setProperty('--my', (e.clientY - r.top) + 'px');
      });
    });

    // Theme integration: sync body attribute + notify canvas
    const syncBodyTheme = () => {
      const current = document.documentElement.getAttribute('data-theme') || 'light';
      document.body.setAttribute('data-current-theme', current);
      const meta = document.querySelector('meta[name="theme-color"]');
      if (meta) {
        const colors = { light: '#f8f9fc', dark: '#0c0d14', 'high-contrast': '#000000' };
        meta.setAttribute('content', colors[current as 'light' | 'dark' | 'high-contrast']);
      }
      window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: current } }));
    };
    syncBodyTheme();

    // Curseur personnalisé + boutons « magnétiques » (ordinateur, animations autorisées)
    const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const calm = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (fine && !calm) {
      const dot = document.querySelector('.cursor-dot') as HTMLElement;
      const ring = document.querySelector('.cursor-ring') as HTMLElement;
      let cx = -100, cy = -100, rx = -100, ry = -100;
      document.documentElement.classList.add('has-cursor');
      window.addEventListener('mousemove', (e) => {
        cx = e.clientX; cy = e.clientY;
        dot.style.transform = `translate3d(${cx}px, ${cy}px, 0)`;
      });
      const follow = () => {
        rx += (cx - rx) * 0.18; ry += (cy - ry) * 0.18;
        ring.style.transform = `translate3d(${rx}px, ${ry}px, 0)`;
        requestAnimationFrame(follow);
      };
      follow();
      document.querySelectorAll('a, button, .bento-card, .stat-card').forEach((el) => {
        el.addEventListener('mouseenter', () => document.documentElement.classList.add('cursor-hover'));
        el.addEventListener('mouseleave', () => document.documentElement.classList.remove('cursor-hover'));
      });
      document.querySelectorAll('.btn-p, .btn-s, .nav-cta').forEach((el) => {
        const b = el as HTMLElement;
        b.addEventListener('mousemove', (e) => {
          const r = b.getBoundingClientRect();
          const x = (e as MouseEvent).clientX - (r.left + r.width / 2);
          const y = (e as MouseEvent).clientY - (r.top + r.height / 2);
          b.style.transform = `translate(${x * 0.2}px, ${y * 0.25}px)`;
        });
        b.addEventListener('mouseleave', () => { b.style.transform = ''; });
      });
    }
  </script>

  <script>
    // Canvas Background — colors from CSS custom properties (theme-aware)
    (() => {
      const w = document.getElementById('bgCanvas') as HTMLCanvasElement;
      if (!w) return;
      const t = w.getContext('2d') as CanvasRenderingContext2D;
      if (!t) return;
      const n = 64, a = 180;
      let cols = 0;
      let rows = 0;
      type Particle = { x: number; y: number; vx: number; vy: number; life: number; decay: number; size: number; color: string };
      let particles: Particle[] = [];
      let d = -9999, h = -9999, mx = -9999, my = -9999;
      let colors = { blue: '59,130,246', indigo: '99,102,241', cyan: '34,211,238', dot: '255,255,255' };

      function readColors() {
        const cs = getComputedStyle(document.documentElement);
        const g = (name: string, fb: string) => (cs.getPropertyValue(name) || fb).trim();
        colors = {
          blue: g('--particle-blue', '59,130,246'),
          indigo: g('--particle-indigo', '99,102,241'),
          cyan: g('--particle-cyan', '34,211,238'),
          dot: g('--grid-dot', '255,255,255'),
        };
      }

      function P() {
        w.width = window.innerWidth;
        w.height = window.innerHeight;
        cols = Math.ceil(w.width / n) + 2;
        rows = Math.ceil(w.height / n) + 2;
      }

      function E(o: number, M: number) {
        if (particles.length > 200) return;
        const pal = [colors.blue, colors.indigo, colors.cyan];
        particles.push({
          x: o, y: M,
          vx: (Math.random() - 0.5) * 0.8,
          vy: (Math.random() - 0.5) * 0.8,
          life: 1,
          decay: 0.005 + Math.random() * 0.01,
          size: 1 + Math.random() * 2,
          color: pal[Math.floor(Math.random() * pal.length)]
        });
      }

      function L() {
        t.clearRect(0, 0, w.width, w.height);
        mx += (d - mx) * 0.15;
        my += (h - my) * 0.15;

        const speed = Math.sqrt((mx - d) ** 2 + (my - h) ** 2);
        if (speed > 3) {
          const count = Math.min(Math.floor(speed / 4), 4);
          for (let i = 0; i < count; i++) E(mx + (Math.random() - 0.5) * 20, my + (Math.random() - 0.5) * 20);
        }

        for (let i = 0; i < rows; i++) {
          for (let e = 0; e < cols; e++) {
            const s = e * n, c = i * n, C = Math.sqrt((s - mx) ** 2 + (c - my) ** 2);
            if (C < a) {
              const g = Math.pow(1 - C / a, 2);
              t.fillStyle = `rgba(${colors.blue},${g * 0.12})`;
              t.fillRect(s - n / 2, c - n / 2, n, n);
              t.beginPath();
              t.arc(s, c, 1.5 + g * 1.5, 0, Math.PI * 2);
              t.fillStyle = `rgba(${colors.indigo},${g * 0.6})`;
              t.fill();
              if (e < cols - 1) {
                const y = Math.sqrt(((e + 1) * n - mx) ** 2 + (c - my) ** 2);
                if (y < a) {
                  const S = (g + Math.pow(1 - y / a, 2)) / 2;
                  t.beginPath(); t.moveTo(s, c); t.lineTo(s + n, c);
                  t.strokeStyle = `rgba(${colors.blue},${S * 0.08})`;
                  t.lineWidth = 1; t.stroke();
                }
              }
              if (i < rows - 1) {
                const y = Math.sqrt((s - mx) ** 2 + ((i + 1) * n - my) ** 2);
                if (y < a) {
                  const S = (g + Math.pow(1 - y / a, 2)) / 2;
                  t.beginPath(); t.moveTo(s, c); t.lineTo(s, c + n);
                  t.strokeStyle = `rgba(${colors.blue},${S * 0.08})`;
                  t.lineWidth = 1; t.stroke();
                }
              }
            } else {
              t.beginPath(); t.arc(s, c, 0.8, 0, Math.PI * 2);
              t.fillStyle = `rgba(${colors.dot},0.05)`;
              t.fill();
            }
          }
        }

        for (let i = particles.length - 1; i >= 0; i--) {
          const p = particles[i];
          p.x += p.vx; p.y += p.vy; p.life -= p.decay;
          if (p.life <= 0) { particles.splice(i, 1); continue; }
          t.beginPath(); t.arc(p.x, p.y, p.size * p.life, 0, Math.PI * 2);
          t.fillStyle = `rgba(${p.color},${p.life * 0.5})`; t.fill();
          t.beginPath(); t.moveTo(p.x, p.y); t.lineTo(p.x - p.vx * 6, p.y - p.vy * 6);
          t.strokeStyle = `rgba(${p.color},${p.life * 0.15})`;
          t.lineWidth = p.size * 0.5; t.stroke();
        }

        const grad = t.createRadialGradient(mx, my, 0, mx, my, a);
        grad.addColorStop(0, `rgba(${colors.blue},0.08)`);
        grad.addColorStop(0.3, `rgba(${colors.indigo},0.05)`);
        grad.addColorStop(1, 'rgba(0,0,0,0)');
        t.fillStyle = grad;
        t.fillRect(mx - a, my - a, a * 2, a * 2);

        requestAnimationFrame(L);
      }

      window.addEventListener('resize', P);
      window.addEventListener('mousemove', e => { d = e.clientX; h = e.clientY; });
      window.addEventListener('mouseleave', () => { d = -9999; h = -9999; });
      window.addEventListener('touchmove', e => {
        if (e.touches.length > 0) { d = e.touches[0].clientX; h = e.touches[0].clientY; }
      }, { passive: true });
      window.addEventListener('touchend', () => { d = -9999; h = -9999; });
      window.addEventListener('themechange', readColors);

      readColors();
      P();
      L();
    })();
  </script>
</BaseLayout>
