{
  "expo": {
    "name": "M-Sec Mobile",
    "slug": "msec-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "msec",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#f8f9fc",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "splash": {
      "backgroundColor": "#f8f9fc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.msec.mobile"
    },
    "android": {
      "package": "com.msec.mobile",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    }
  }
}