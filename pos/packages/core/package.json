{
  "name": "@pos/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Règles métier pures du POS — zéro dépendance UI, testables sans navigateur ni appareil",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.2",
    "vitest": "^3.0.5"
  }
}